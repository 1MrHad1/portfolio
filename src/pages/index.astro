---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import CountUp from '../components/CountUp.tsx';
import LeadForm from '../components/LeadForm.astro';
import {
  sites,
  slugify,
  PLATFORM_LABEL,
  type Platform,
  caseStudies,
  capabilities,
  jobs,
  automations,
  earlyWork,
  profile,
} from '../data/portfolio';

const platforms = Object.keys(PLATFORM_LABEL) as Platform[];
const countFor = (p: Platform) => sites.filter(([, plat]) => plat === p).length;
---
<Layout>
  <div class="progress" aria-hidden="true"><i></i></div>
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="fallback-glow" aria-hidden="true"></div>

  <header class="nav">
    <a class="logo" href="#top" aria-label="Haseeb Ahmed Danish, back to top">haseeb<span>.</span></a>
    <nav class="nav-links" aria-label="Sections">
      <a href="#work">work</a>
      <a href="#stack">stack</a>
      <a href="#automation">automation</a>
      <a href="#experience">experience</a>
      <a href="#clients">clients</a>
    </nav>
    <div class="nav-end">
      <button id="themeToggle" class="tgl" aria-label="Toggle light and dark theme" title="Toggle theme">◐</button>
      <a class="btn btn-sm" href="#contact" data-lead data-magnetic>Let's talk</a>
    </div>
  </header>

  <main id="top">
    <!-- ================= HERO ================= -->
    <section class="hero wrap" data-formation="0" data-intensity="1">
      <p class="eyebrow" data-r><span class="dot"></span>Senior Full-Stack Developer · 5+ years</p>
      <h1 data-r>Full-stack systems<br />that <em>ship</em> and <em>sell</em>.</h1>
      <p class="hero-sub" data-r>{profile.heroSub}</p>
      <div class="actions" data-r>
        <a class="btn" href="#work" data-magnetic>See the work</a>
        <a class="btn btn-ghost" href="#contact" data-lead>Get in touch</a>
      </div>
      <ul class="hero-stack" data-r aria-label="Core stack">
        {profile.heroStack.map((s) => <li>{s}</li>)}
      </ul>
      <p class="legend" aria-hidden="true"><b>98</b> nodes · one for every site in the network I automate</p>
      <a class="scroll-cue" href="#about" aria-label="Scroll to about"><span></span>scroll</a>
    </section>

    <!-- ================= ABOUT ================= -->
    <section id="about" class="wrap about" data-formation="0" data-intensity="0.6">
      <div data-r>
        <ScrollReveal
          client:visible
          className="lead-reveal"
          text={profile.about}
        />
        <p class="lead" set:html={profile.aboutLead} />
      </div>
      <div class="metrics" data-r="1">
        <CountUp client:visible to={5} suffix="+" label="years shipping for the web" />
        <CountUp client:visible to={sites.length} label="client sites shipped" />
        <CountUp client:visible to={98} label="site publishing network" />
        <CountUp client:visible to={40} suffix="+" label="WordPress sites automated" />
      </div>
    </section>


    <!-- ================= CASE STUDIES ================= -->
    <section id="work" class="wrap" data-formation="1" data-intensity="0.5">
      <header class="sec-head" data-r>
        <p class="sh"><span class="n">01</span> Selected work</p>
        <h2>Products taken from schema to storefront.</h2>
      </header>
      <div class="bento">
        {caseStudies.map((c, i) => (
          <article class={`cs cs-${c.size}`} data-tilt="5" data-r={i % 3} id={`cs-${c.id}`}>
            <div class="cs-inner">
              {c.thumb && (
                <figure class="shot">
                  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{c.links[0]?.label}</span></div>
                  <img src={c.thumb} alt={`${c.name} homepage`} width="1200" height="750" loading="lazy" decoding="async" />
                </figure>
              )}
              <div class="cs-body">
                <p class="kicker">{c.kicker}{c.status && <span class="status">{c.status}</span>}</p>
                <h3>{c.name}</h3>
                <p class="summary">{c.summary}</p>
                <ul class="points">
                  {(c.size === 'md' ? c.points.slice(0, 1) : c.points).map((p) => <li>{p}</li>)}
                </ul>
                <ul class="tags" aria-label="Stack">
                  {c.stack.map((s) => <li>{s}</li>)}
                </ul>
                <div class="cs-links">
                  {c.links.length
                    ? c.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)
                    : <span class="private">private repository</span>}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================= CAPABILITIES ================= -->
    <section id="stack" class="wrap" data-formation="1" data-intensity="0.75">
      <header class="sec-head" data-r>
        <p class="sh"><span class="n">02</span> Capabilities</p>
        <h2>One engineer, every layer.</h2>
      </header>
      <div class="layers">
        {capabilities.map((cap, i) => (
          <div class="layer" data-r={i}>
            <p class="layer-n">L{String(capabilities.length - i).padStart(2, '0')}</p>
            <h3>{cap.title}</h3>
            <ul class="chips">{cap.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= AUTOMATION ================= -->
    <section id="automation" class="wrap" data-formation="2" data-intensity="0.7">
      <header class="sec-head" data-r>
        <p class="sh"><span class="n">03</span> Automation &amp; AI engineering</p>
        <h2>Pipelines with a human in the loop.</h2>
        <p class="lead">Repetitive publishing, SEO and QA work, turned into reliable pipelines that still ask a person before anything goes live.</p>
      </header>
      <div class="autos">
        {automations.map((a, i) => (
          <article class="auto" data-r={i % 2}>
            <h3>{a.title}</h3>
            <p class="tag">{a.tag}</p>
            <p class="desc" set:html={a.desc} />
            <div class="flow" style={`--n:${a.flow.length}`}>
              {a.flow.map((n, j) => (
                <span class={a.hot.includes(j) ? 'node hot' : 'node'} style={`--i:${j}`}>{n}</span>
              ))}
            </div>
            <p class="result">Result: <b>{a.result}</b></p>
          </article>
        ))}
      </div>
    </section>

    <!-- ================= EXPERIENCE ================= -->
    <section id="experience" class="wrap">
      <header class="sec-head" data-r>
        <p class="sh"><span class="n">04</span> Experience</p>
        <h2>Five teams, one habit: ship it measured.</h2>
      </header>
      <ol class="timeline">
        {jobs.map((j, i) => (
          <li class="job" data-r={i % 2}>
            <p class="yr">{j.yr}</p>
            <div>
              <h3>{j.role} <span>· {j.org}</span></h3>
              <p>{j.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ================= CLIENTS ================= -->
    <section id="clients" class="wrap" data-formation="3" data-intensity="0.45">
      <header class="sec-head" data-r>
        <p class="sh"><span class="n">05</span> Client work · {sites.length} sites</p>
        <h2>Live sites, across four platforms.</h2>
      </header>
      <div class="filters" role="group" aria-label="Filter by platform" data-r>
        <button class="filt" data-f="all" aria-pressed="true">all · {sites.length}</button>
        {platforms.map((p) => (
          <button class="filt" data-f={p} aria-pressed="false">{PLATFORM_LABEL[p]} · {countFor(p)}</button>
        ))}
      </div>
      <div class="grid" id="grid">
        {sites.map(([dom, plat], i) => (
          <a class="site" data-plat={plat} href={`https://${dom}`} rel="noopener" target="_blank" data-tilt="8" data-r={i % 3}>
            <img
              src={`/thumbs/${slugify(dom)}.jpg`}
              alt={`Screenshot of the ${dom} website`}
              width="600" height="375"
              loading="lazy" decoding="async"
            />
            <div class="site-body">
              <span class="dom">{dom}</span>
              <span class={`badge b-${plat}`}>{PLATFORM_LABEL[plat]}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ================= EARLY WORK ================= -->
    <section id="early" class="wrap">
      <header class="sec-head" data-r>
        <p class="sh"><span class="n">06</span> Early projects</p>
      </header>
      <div class="early">
        {earlyWork.map((p, i) => (
          <a class="early-card" href={p.link} rel="noopener" target="_blank" data-r={i}>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="plink">{p.label}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact" class="wrap contact" data-formation="4" data-intensity="1">
      <p class="eyebrow" data-r>Contact</p>
      <h2 data-r>Let's build something<br />that <em>converts</em>.</h2>
      <p class="lead" data-r>Full-stack builds, Shopify storefronts, WordPress → Next.js migrations and automation pipelines. The fastest way to reach me:</p>
      <div class="contacts" data-r>
        <a class="btn" href="#contact" data-lead data-magnetic>Send a request</a>
        <a class="btn btn-ghost" href="mailto:umaildanish776@gmail.com">umaildanish776@gmail.com</a>
        <a class="btn btn-ghost" href="tel:+919113021043">+91 91130 21043</a>
        <a class="btn btn-ghost" href="https://github.com/1MrHad1" rel="noopener" target="_blank">github.com/1MrHad1 ↗</a>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p>B.E. Computer Science · Maharaja Institute of Technology, Mysore</p>
    <p>Built with Astro, Three.js and GSAP · deployed on Netlify</p>
  </footer>

  <LeadForm />

  <script>
    import '../scripts/app';
  </script>
</Layout>
