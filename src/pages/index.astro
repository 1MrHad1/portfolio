---
import Layout from '../layouts/Layout.astro';

/* Content is unchanged from the previous build — same 18 client sites, same
   five roles, same three pipelines. Only the register changed. */

const sites: [string, 'sh' | 'wp' | 'cr'][] = [
  ['fameninja.com', 'wp'], ['artsncraftsindia.com', 'wp'], ['gogrowth.in', 'wp'],
  ['alhawaeanetwork.com', 'wp'], ['acquifin.us', 'wp'],
  ['kesariananta.com', 'sh'], ['banterkitchen.com', 'sh'], ['mimamsaa.com', 'sh'], ['stravage.in', 'sh'],
  ['the-culture.in', 'sh'], ['anythingvegan.ae', 'sh'],
  ['swingsaga.com', 'sh'], ['craftdelights.in', 'sh'], ['koora.com.au', 'sh'],
  ['thecryptoupdates.com', 'cr'], ['theblockopedia.com', 'cr'], ['tbpmedia.io', 'cr'], ['defidraft.com', 'cr'],
];
const LABEL = { sh: 'Shopify', wp: 'WordPress', cr: 'Media' };
const slugify = (d: string) => d.replace(/[^a-z0-9]/g, '-');

const stats = [
  { n: '5', suffix: '+', l: 'years building' },
  { n: '18', suffix: '', l: 'client sites shipped' },
  { n: '98', suffix: '', l: 'site publishing network' },
  { n: '40', suffix: '+', l: 'WordPress sites automated' },
];

const jobs = [
  { yr: 'Current', role: 'Developer', org: 'Rankkking', desc: 'Connected Claude Code to WordPress sites via MCP to automate SEO best practices — audits, broken-link detection, sitemap updates. Built AI-assisted multi-site publishing with human approval gates, plus high-converting funnels in custom code and FlexiFunnels.' },
  { yr: '2024 — 2026', role: 'Developer', org: 'GoGrowth Labs', desc: 'Built and maintained WooCommerce and Shopify solutions. Revamped breezyla.com, saving the client $1,000/month by implementing premium features natively. Applied CRO-driven UI/UX and technical SEO to lift conversions and rankings.' },
  { yr: '2023 — 2024', role: 'WordPress Developer', org: 'ArtsnCraftsIndia', desc: 'Optimized checkout flows and product pages, significantly reducing cart abandonment and increasing conversion through streamlined experiences.' },
  { yr: '2023', role: 'WordPress Developer', org: 'Peoplewoo', desc: 'Implemented UI/UX designs and developed custom page templates for distinct sections across various WordPress sites.' },
  { yr: '2022 — 2023', role: 'Front-End / WordPress Developer', org: 'Design Script', desc: 'Designed and built landing pages, e-commerce sites, and blogs for multiple clients.' },
];

const automations = [
  {
    title: 'MainWP multi-site content network',
    tag: 'n8n · Cloudflare Workers · MainWP REST · LLM · Telegram',
    desc: 'One order fans out to a <span class="k">98-site WordPress network</span>. An AI quality-gate screens each article, a Cloudflare Worker reverse-proxy relay defeats the origin bot-wall, drafts land on every selected site, and a single Telegram approval publishes them all — with graceful per-site failure handling.',
    flow: ['order form', 'Google Doc', 'AI QA gate', 'draft ×98', 'Telegram approve', 'publish all'],
    hot: [2, 4],
    result: 'one order → one approval → live across the network in minutes, not hours.',
  },
  {
    title: 'TheCryptoUpdates + TheBlockopedia order engine',
    tag: 'n8n · WordPress REST · Rank Math · LLM · Tally',
    desc: 'Client orders become <span class="k">scheduled, SEO-ready posts</span> on two high-traffic crypto publications — parse and route the target, ingest the doc, AI QA, auto-process the featured image, write Rank Math meta with IST scheduling, then a Telegram approval to publish. Includes automatic duplicate-title de-duplication.',
    flow: ['Tally order', 'resolve site', 'AI QA gate', 'image + SEO', 'approve', 'schedule / publish'],
    hot: [2, 4],
    result: 'hands-off publishing with a human gate and consistent SEO metadata.',
  },
  {
    title: 'AI-driven SEO & security via MCP',
    tag: 'Claude (MCP) · WordPress · GSC · GA4',
    desc: 'Connected Claude to <span class="k">40+ live WordPress sites</span> via Model Context Protocol servers to run technical SEO audits, security hardening, broken-link detection, and sitemap/metadata updates — with GSC + GA4 wired in for an automated SEO command-center.',
    flow: ['Claude + MCP', '40+ WP sites', 'audit + fix', 'GSC / GA4 report'],
    hot: [2],
    result: 'network-wide audits and fixes executed programmatically.',
  },
];

const skills = [
  { h: 'Core technologies', wide: false, items: ['Shopify (Liquid)','WordPress','WooCommerce','React','JavaScript','PHP','HTML5','CSS3','MySQL'] },
  { h: 'Specializations', wide: false, items: ['Custom themes','Liquid templating','Headless storefronts','Checkout customization','Technical SEO','CRO','Schema markup','Reverse proxy'] },
  { h: 'Automation & AI engineering', wide: true, items: ['Claude + MCP','n8n pipelines','MainWP network','Cloudflare Workers','LLM quality-gates','Telegram approvals','GSC + GA4 via MCP','WP → Next.js migrations'] },
];

const projects = [
  { title: 'Task Tracker App', desc: 'A focused task manager with persistent state and a clean, fast UI.', link: 'https://profound-cheesecake-894687.netlify.app', label: 'live demo ↗' },
  { title: 'Weather App', desc: 'Live conditions and forecasts powered by the OpenWeather API.', link: 'https://poetic-sorbet-b71dc5.netlify.app', label: 'live demo ↗' },
  { title: 'Workout Buddy', desc: 'Full-stack MERN app for logging and tracking workouts.', link: 'https://github.com/1MrHad1/WorkOut-Buddy-MERN-', label: 'source ↗' },
];

const counts = { sh: sites.filter((s) => s[1] === 'sh').length, wp: sites.filter((s) => s[1] === 'wp').length, cr: sites.filter((s) => s[1] === 'cr').length };
---
<Layout>
  <header class="nav">
    <div class="wrap nav__in">
      <a class="nav__mark" href="#top">Haseeb Ahmed Danish</a>
      <nav class="nav__links" aria-label="Sections">
        <a href="#work">Work</a>
        <a href="#automation">Automation</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
      <button id="themeToggle" class="tgl" aria-label="Toggle light and dark theme" title="Toggle theme">◐</button>
    </div>
  </header>

  <main id="top">

    <!-- Marquee hero: one thought set big, mono dateline at the left margin
         as the editorial anchor. No imagery, no CTA stack, no eyebrow. -->
    <section class="hero">
      <div class="wrap">
        <div class="hero__grid">
          <p class="dateline mono">
            <span>Senior Developer</span>
            <span>Mysore, India</span>
            <span>Portfolio 2026</span>
          </p>
          <div>
            <h1>Storefronts that convert, and the <em>pipelines</em> that run them.</h1>
            <p class="hero__sub">
              Five years of Shopify, WordPress and React commerce — lately paired with
              AI automation that publishes and audits across a 98-site network, with a
              human approval gate on every release.
            </p>
          </div>
        </div>

        <div class="stats">
          {stats.map((s) => (
            <div class="stat">
              <b>{s.n}<i>{s.suffix}</i></b>
              <span>{s.l}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="section">
      <div class="wrap">
        <div class="shead">
          <h2>Client work</h2>
          <p class="mono" style="margin:0">18 sites shipped</p>
        </div>
        <div class="filters" role="group" aria-label="Filter by platform">
          <button class="filt" data-f="all" aria-pressed="true">All · 18</button>
          <button class="filt" data-f="sh" aria-pressed="false">Shopify · {counts.sh}</button>
          <button class="filt" data-f="wp" aria-pressed="false">WordPress · {counts.wp}</button>
          <button class="filt" data-f="cr" aria-pressed="false">Media · {counts.cr}</button>
        </div>
        <div class="grid" id="grid">
          {sites.map(([dom, plat]) => (
            <a class="card" data-plat={plat} href={`https://${dom}`} rel="noopener" target="_blank">
              <img class="thumb-img" src={`/thumbs/${slugify(dom)}.jpg`}
                   alt={`Screenshot of ${dom}`} width="600" height="375"
                   loading="lazy" decoding="async" style={`background:var(--${plat}-bg)`} />
              <div class="body">
                <span class="dom">{dom}</span>
                <span class={`badge b-${plat}`}>{LABEL[plat]}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="automation" class="section section--sunk">
      <div class="wrap">
        <div class="shead">
          <h2>Automation &amp; AI engineering</h2>
          <p class="mono" style="margin:0">3 flagship pipelines</p>
        </div>
        {automations.map((a) => (
          <div class="auto">
            <h3>{a.title}</h3>
            <p class="tag">{a.tag}</p>
            <p class="desc" set:html={a.desc} />
            <div class="flow">
              {a.flow.map((n, i) => (
                <>
                  <span class={a.hot.includes(i) ? 'node hot' : 'node'}>{n}</span>
                  {i < a.flow.length - 1 && <span class="arrow">→</span>}
                </>
              ))}
            </div>
            <p class="result">Result — <b>{a.result}</b></p>
          </div>
        ))}
      </div>
    </section>

    <section id="experience" class="section">
      <div class="wrap">
        <div class="shead">
          <h2>Experience</h2>
          <p class="mono" style="margin:0">2022 — present</p>
        </div>
        {jobs.map((j) => (
          <div class="job">
            <div class="yr">{j.yr}</div>
            <div>
              <h3>{j.role} — <span>{j.org}</span></h3>
              <p>{j.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="skills" class="section section--sunk">
      <div class="wrap">
        <div class="shead"><h2>Skills</h2></div>
        <div class="skills">
          {skills.map((s) => (
            <div class={s.wide ? 'sk sk--wide' : 'sk'}>
              <h3>{s.h}</h3>
              <div class="chips">{s.items.map((c) => <span class="chip">{c}</span>)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="section">
      <div class="wrap">
        <div class="shead"><h2>Personal projects</h2></div>
        <div class="proj">
          {projects.map((p) => (
            <div class="pcard">
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
              <a href={p.link} rel="noopener">{p.label}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section section--sunk">
      <div class="wrap contact">
        <p class="mono">Contact</p>
        <h2>Let's build something that converts.</h2>
        <p class="lead">
          Open to Shopify, WordPress and React work — from custom storefronts to
          automation pipelines.
        </p>
        <div class="contacts">
          <a class="cbtn cbtn--primary" href="mailto:umaildanish776@gmail.com">umaildanish776@gmail.com</a>
          <a class="cbtn" href="tel:+919113021043">+91 91130 21043</a>
          <a class="cbtn" href="https://github.com/1MrHad1" rel="noopener">github.com/1MrHad1</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="section--sunk">
    <div class="wrap foot mono">
      <span>B.E. Computer Science · Maharaja Institute of Technology, Mysore</span>
      <span>Astro · Netlify</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    document.getElementById('themeToggle')?.addEventListener('click', () => {
      const next = (root.getAttribute('data-theme') || 'light') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch {}
    });

    const grid = document.getElementById('grid');
    document.querySelectorAll('.filt').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.filt').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        const f = b.getAttribute('data-f');
        grid?.querySelectorAll('.card').forEach((c) => {
          (c as HTMLElement).style.display = f === 'all' || c.getAttribute('data-plat') === f ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
